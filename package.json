{
  "name": "SAFAD",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "test": "vitest"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.82.0",
    "eslint-plugin-vue": "^10.11.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sass-embedded": "^1.104.1",
    "typescript": "npm:typescript-native-bridge@latest",
    "unplugin-inject-preload": "^3.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
